{
  "manifest_version": 3,
  "name": "LinkedIn Learning Video Saver",
  "short_name": "LL Video Saver",
  "version": "2.4.5",
  "description": "Captures the stream your lesson player actually uses and saves the video and selected subtitles locally.",
  "permissions": ["downloads", "storage", "tabs", "offscreen", "webRequest", "webNavigation"],
  "host_permissions": [
    "https://www.linkedin.com/*",
    "https://*.licdn.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://www.linkedin.com/learning/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "LinkedIn Learning Video Saver"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "minimum_chrome_version": "111"
}
